{
  // Radio Porche: un solo Worker sirve la web, los WebSockets y los datos.
  // Desplegar como WORKER (no como Cloudflare Pages).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radio-porche",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOCKER", "class_name": "Locker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Locker"] }
  ],
  "vars": {
    // Opcional: clave PÚBLICA de Turnstile. La secreta va como secret (ver README).
    "TURNSTILE_SITEKEY": ""
  },
  // Identificador de cada despliegue: la app se recarga sola cuando hay versión nueva
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
